{
  "name": "montlake-pta-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:wix": "node scripts/bootstrap-wix-snapshot.mjs",
    "build": "node scripts/build.mjs",
    "build:wix-publisher": "esbuild wix/backend/github-publish.js --bundle --platform=node --format=esm --target=node18 --external:crypto --external:wix-*",
    "check:agents": "node scripts/check-agent-harness.mjs",
    "check:cutover": "node scripts/check-cutover.mjs",
    "migrate:fundraising": "node scripts/migrate-fundraising.mjs",
    "setup:wix-cms": "node scripts/setup-wix-cms.mjs",
    "sync:calendar": "node scripts/sync-calendar.mjs",
    "sync:newsletters": "node scripts/sync-newsletters.mjs",
    "sync:wix": "node scripts/sync-wix.mjs",
    "update:wix-page": "node scripts/update-wix-page.mjs",
    "test": "node scripts/check-site.mjs && npm run test:unit",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:wix-page": "node --test scripts/update-wix-page.test.mjs"
  },
  "dependencies": {
    "@wix/blog": "^1.0.647",
    "@wix/data": "^1.0.512",
    "@wix/ecom": "^1.0.2482",
    "@wix/events": "^1.0.862",
    "@wix/redirects": "^1.0.126",
    "@wix/sdk": "^1.21.16",
    "@wix/stores": "^1.0.890",
    "node-ical": "^0.27.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "esbuild": "^0.28.2",
    "htmlparser2": "^12.0.0"
  }
}
