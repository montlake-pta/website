# Local administrative sync only. Never commit a populated .env file.
WIX_API_KEY=
WIX_SITE_ID=f17e8f26-4d30-4997-bca1-82f1599221bb
# Optional account context for Headless setup; it does not grant permissions.
WIX_ACCOUNT_ID=
# Public visitor configuration. Read-only information can load before full transactions.
WIX_HEADLESS_CLIENT_ID=
WIX_HEADLESS_READ_ONLY=true
# Full transactions require read-only=false and verified visitor/checkout flows.
WIX_HEADLESS_ENABLED=false
# Blank uses https://montlake-pta.github.io/website/. See docs/operations.md
# before preparing a final-domain build or modifying DNS.
SITE_URL=
# Blank falls back to src/newsletter.config.json during local newsletter sync.
CONSTANT_CONTACT_ARCHIVE_ID=
